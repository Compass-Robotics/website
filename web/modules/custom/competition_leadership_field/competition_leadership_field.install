<?php

use Drupal\field\Entity\FieldStorageConfig;

/**
 * Ensure robotics is installed and field provider metadata is migrated.
 */
function competition_leadership_field_update_11001(): void {
  if (!\Drupal::moduleHandler()->moduleExists('robotics')) {
    \Drupal::service('module_installer')->install(['robotics'], TRUE);
  }

  $storages = \Drupal::entityTypeManager()
    ->getStorage('field_storage_config')
    ->loadByProperties([
    'type' => 'competition_leadership',
    ]);

  foreach ($storages as $storage) {
    if (!$storage instanceof FieldStorageConfig) {
      continue;
    }

    if ($storage->get('module') !== 'competition_leadership_field') {
      continue;
    }

    $storage->set('module', 'robotics');
    $storage->save();
  }
}
