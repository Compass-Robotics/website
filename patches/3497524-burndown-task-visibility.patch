@@ -0,0 +1,71 @@
+/* Keep task modal shell consistent regardless of auth/theme asset order. */
+.ui-dialog.ui-widget.ui-front {
+  border-radius: 12px;
+  overflow: hidden;
+}
+
+.ui-dialog.ui-widget.ui-front .ui-dialog-titlebar {
+  min-height: 2.25rem;
+}
+
+.ui-dialog.ui-widget.ui-front .ui-dialog-titlebar-close {
+  position: absolute !important;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  width: 34px;
+  height: 34px;
+  padding: 0;
+  margin: 0;
+  line-height: 1;
+  top: calc(0.3rem + 17px) !important;
+  right: 0.3rem !important;
+  left: auto !important;
+}
+
+.ui-dialog.ui-widget.ui-front .ui-dialog-titlebar-close .ui-button-icon,
+.ui-dialog.ui-widget.ui-front .ui-dialog-titlebar-close .ui-icon {
+  position: absolute;
+  top: 50%;
+  left: 50%;
+  width: 16px;
+  height: 16px;
+  margin: 0;
+  transform: translate(-50%, -50%);
+}
+
+.ui-dialog.ui-widget.ui-front .ui-dialog-titlebar-close .ui-button-icon-space {
+  display: none;
+}
+
+.ui-dialog.ui-widget.ui-front .ui-dialog-content#drupal-modal {
+  padding: 0.75rem 1rem 1rem;
+  background-color: #ffffff !important;
+}
+
+@media (max-width: 767px) {
+  .ui-dialog.ui-widget.ui-front {
+    display: flex;
+    flex-direction: column;
+    width: 100vw !important;
+    max-width: 100vw !important;
+    height: 100dvh !important;
+    max-height: 100dvh !important;
+    left: 0 !important;
+    top: 0 !important;
+    margin: 0 !important;
+    border-radius: 0;
+    overflow: hidden;
+  }
+
+  .ui-dialog.ui-widget.ui-front .ui-dialog-content#drupal-modal {
+    flex: 1 1 auto;
+    min-height: 0;
+    width: 100% !important;
+    height: auto !important;
+    max-height: none !important;
+    overflow-y: auto !important;
+    overflow-x: hidden;
+    -webkit-overflow-scrolling: touch;
+  }
+}
diff --git a/js/burndown.task_log_tabs.js b/js/burndown.task_log_tabs.js
new file mode 100644
index 0000000000000000000000000000000000000000..0c9b2a33ac119bc3cba340780947f184fcb19f10
--- /dev/null
+++ b/js/burndown.task_log_tabs.js
@@ -0,0 +1,37 @@
+/**
+ * @file
+ * Tab switching behavior for rendered Burndown task log field output.
+ */
+(function (Drupal, once) {
+  Drupal.behaviors.burndownTaskLogTabs = {
+    attach(context) {
+      once('burndownTaskLogTabs', '.burndown-log-tabs', context).forEach((wrapper) => {
+        const tabs = wrapper.querySelectorAll('.log_tabs a[data-log-tab]');
+        const panels = wrapper.querySelectorAll('.burndown-task-log-panel[data-log-panel]');
+
+        const activate = (target) => {
+          tabs.forEach((tab) => {
+            const active = tab.getAttribute('data-log-tab') === target;
+            tab.classList.toggle('is-active', active);
+          });
+
+          panels.forEach((panel) => {
+            const active = panel.getAttribute('data-log-panel') === target;
+            panel.classList.toggle('is-active', active);
+            panel.classList.toggle('is-hidden', !active);
+          });
+        };
+
+        tabs.forEach((tab) => {
+          tab.addEventListener('click', (event) => {
+            event.preventDefault();
+            activate(tab.getAttribute('data-log-tab'));
+          });
+        });
+
+        const current = wrapper.querySelector('.log_tabs a.is-active[data-log-tab]');
+        activate(current ? current.getAttribute('data-log-tab') : 'all');
+      });
+    },
+  };
+})(Drupal, once);
