diff --git a/tests/src/Functional/TaskProjectChangeTest.php b/tests/src/Functional/TaskProjectChangeTest.php
new file mode 100644
index 0000000000000000000000000000000000000000..c13e84aa7cb8994f68ce03e07249c20afcf426a9
--- /dev/null
+++ b/tests/src/Functional/TaskProjectChangeTest.php
@@ -0,0 +1,132 @@
+<?php
+
+namespace Drupal\Tests\burndown\Functional;
+
+use Drupal\burndown\Entity\Project;
+use Drupal\burndown\Entity\Sprint;
+use Drupal\burndown\Entity\Swimlane;
+use Drupal\burndown\Entity\Task;
+use Drupal\Tests\BrowserTestBase;
+
+/**
+ * Verifies Task behavior when its Project changes.
+ *
+ * @group burndown
+ */
+class TaskProjectChangeTest extends BrowserTestBase {
+
+  /**
+   * {@inheritdoc}
+   */
+  protected $defaultTheme = 'stark';
+
+  /**
+   * {@inheritdoc}
+   */
+  protected static $modules = ['burndown'];
+
+  /**
+   * Tests ticket IDs and Columns when moving Tasks between Projects.
+   */
+  public function testProjectChangeUpdatesTicketIdAndSwimlane(): void {
+    $source = $this->createProject('Source Project', 'SOURCE', 'sprint');
+    $destination = $this->createProject('Destination Project', 'DEST', 'kanban');
+    $source_sprint = $this->createSprint($source, 'Source Sprint');
+
+    $source_in_progress = Swimlane::getSwimlane($source->getShortcode(), 'In Progress');
+    $source_unique = $this->createSwimlane($source, 'Source Only', 2, FALSE);
+    $destination_in_progress = Swimlane::getSwimlane($destination->getShortcode(), 'In Progress');
+    $this->assertNotFalse($source_in_progress);
+    $this->assertNotFalse($destination_in_progress);
+    $destination_backlog = Swimlane::getBacklogFor($destination->getShortcode());
+
+    $this->assertNotFalse($destination_backlog);
+
+    // Seed the destination counter so the moved Tasks must receive new IDs.
+    $existing = $this->createTask($destination, $destination_backlog, 'Existing destination task');
+    $this->assertSame('DEST-1', $existing->getTicketId());
+
+    $same_name_task = $this->createTask($source, $source_in_progress, 'Same column task', $source_sprint);
+    $original_ticket_id = $same_name_task->getTicketId();
+    $same_name_task->setProject($destination)->save();
+
+    $this->assertNotSame($original_ticket_id, $same_name_task->getTicketId());
+    $this->assertSame('DEST-2', $same_name_task->getTicketId());
+    $this->assertSame($source_in_progress->getName(), $same_name_task->getSwimlane()->getName());
+    $this->assertTrue($same_name_task->get('sprint')->isEmpty());
+
+    $fallback_task = $this->createTask($source, $source_unique, 'Fallback column task');
+    $fallback_task->setProject($destination)->save();
+
+    $this->assertSame('DEST-3', $fallback_task->getTicketId());
+    $this->assertSame($destination_backlog->id(), $fallback_task->get('swimlane')->target_id);
+  }
+
+  /**
+   * Creates a Project entity for test fixtures.
+   */
+  protected function createProject(string $name, string $shortcode, string $board_type): Project {
+    /** @var \Drupal\burndown\Entity\Project $project */
+    $project = Project::create([
+      'type' => 'project',
+      'name' => $name,
+      'shortcode' => $shortcode,
+      'board_type' => $board_type,
+      'estimate_type' => 'geometric',
+      'status' => 1,
+    ]);
+    $project->save();
+    return $project;
+  }
+
+  /**
+   * Creates a Sprint entity for a Project.
+   */
+  protected function createSprint(Project $project, string $name): Sprint {
+    /** @var \Drupal\burndown\Entity\Sprint $sprint */
+    $sprint = Sprint::create([
+      'name' => $name,
+      'project' => $project->id(),
+      'status' => 'new',
+      'sort_order' => 0,
+    ]);
+    $sprint->save();
+    return $sprint;
+  }
+
+  /**
+   * Creates a Swimlane entity for a Project.
+   */
+  protected function createSwimlane(Project $project, string $name, int $sort_order, bool $show_backlog): Swimlane {
+    /** @var \Drupal\burndown\Entity\Swimlane $swimlane */
+    $swimlane = Swimlane::create([
+      'name' => $name,
+      'project' => $project->id(),
+      'sort_order' => $sort_order,
+      'show_backlog' => $show_backlog ? 1 : 0,
+      'show_project_board' => 1,
+      'show_completed' => 0,
+      'status' => 1,
+    ]);
+    $swimlane->save();
+    return $swimlane;
+  }
+
+  /**
+   * Creates and saves a Task entity.
+   */
+  protected function createTask(Project $project, Swimlane $swimlane, string $name, ?Sprint $sprint = NULL): Task {
+    /** @var \Drupal\burndown\Entity\Task $task */
+    $task = Task::create([
+      'type' => 'task',
+      'name' => $name,
+      'priority' => '2',
+      'project' => $project->id(),
+      'swimlane' => $swimlane->id(),
+      'sprint' => $sprint ? $sprint->id() : NULL,
+    ]);
+    $task->save();
+    return $task;
+  }
+
+}
