{#
/**
 * @file
 * Theme override to display a menu.
 *
 * Available variables:
 * - menu_name: The machine name of the menu.
 * - items: A nested list of menu items. Each menu item contains:
 *   - attributes: HTML attributes for the menu item.
 *   - below: The menu item child items.
 *   - title: The menu link title.
 *   - url: The menu link URL, instance of \Drupal\Core\Url
 *   - localized_options: Menu link localized options.
 *   - is_expanded: TRUE if the link has visible children within the current
 *     menu tree.
 *   - is_collapsed: TRUE if the link has children within the current menu tree
 *     that are not currently visible.
 *   - in_active_trail: TRUE if the link is in the active trail.
 */
#}
{% set menu_classes = menu_classes|default([])|merge(['social-menu', 'flex', 'flex-row', 'gap-4', 'list-none', 'p-0'])|filter(v => v is not empty) %}

<ul class="{{ menu_classes|join(' ') }}">
  {% for item in items %}
    {% set link_options = item.options|default({}) %}
    {% if item.original_link is defined %}
      {% set original_link_options = item.original_link.getOptions()|default({}) %}
      {% if original_link_options is iterable and (link_options.icon is not defined or link_options.icon.target_id|default('') is empty) %}
        {% set link_options = original_link_options %}
      {% endif %}
    {% endif %}

    {% set link_title = item.title|default('')|striptags|trim %}
    {% if link_title is empty and item.original_link is defined %}
      {% set link_title = item.original_link.getTitle()|default('')|striptags|trim %}
    {% endif %}

    {% set icon_target = link_options.icon.target_id|default('') %}
    {% set icon_provider = 'phosphor' %}
    {% set icon_id = '' %}
    {% if icon_target is not empty and ':' in icon_target %}
      {% set icon_parts = icon_target|split(':', 2) %}
      {% set icon_provider = icon_parts[0] %}
      {% set icon_id = icon_parts[1] %}
    {% endif %}

    {% set icon_settings = link_options.icon.settings[icon_provider]|default({}) %}
    {% set icon_alt = icon_settings.alt|default('') %}
    {% set aria_label = icon_alt is not empty ? icon_alt : (link_title is not empty ? 'Follow us on ' ~ link_title : 'Social media link') %}
    {% set link_target = link_options.attributes.target|default('_blank') %}
    {% set link_rel_raw = link_options.attributes.rel|default('') %}
    {% set link_rel = link_rel_raw is iterable ? link_rel_raw|join(' ') : link_rel_raw %}
    {% if link_target == '_blank' and link_rel is empty %}
      {% set link_rel = 'noopener noreferrer' %}
    {% endif %}

    <li class="social-menu--item text-accent">
      <a
        href="{{ item.url }}"
        aria-label="{{ aria_label }}"
        target="{{ link_target }}"
        {% if link_rel is not empty %}rel="{{ link_rel }}"{% endif %}
        class="social-menu--icon align-center flex aspect-square opacity-100 hover:opacity-60"
      >
        {% if icon_id is not empty %}
          {{
            icon(
              icon_provider,
              icon_id,
              {
                size: icon_settings.size|default(32),
                color: icon_settings.color|default('currentColor'),
                alt: ''
              }
            )
          }}
        {% else %}
          <span class="visually-hidden">{{ aria_label }}</span>
        {% endif %}
      </a>
    </li>
  {% endfor %}
</ul>
